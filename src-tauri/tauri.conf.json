{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Latex Live",
    "version": "0.1.3",
    "identifier": "net.hillemanns.tobias.latex-live",
    "build": {
        "beforeDevCommand": "nub run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "nub run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [{"title": "Latex Live", "width": 800, "height": 600}],
        "security": {"csp": null}
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "shortDescription": "A LaTeX editor with live PDF preview.",
        "copyright": "© 2026 Tobias Hillemanns",
        "license": "MIT",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
